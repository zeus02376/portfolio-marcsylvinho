---
import Layout from "../../layouts/Layout.astro";

const findings = [
	{
		title: "Injection SQL — contournement de l'authentification",
		owasp: "A03:2021 · Injection",
		severity: "Élevée",
		severityClass: "border-orange-400/30 bg-orange-400/10 text-orange-300",
		vector: "Formulaire de connexion · Burp Suite Repeater",
		payload: "' OR 1=1--",
		impact:
			"Une requête construite par concaténation peut être altérée pour contourner l'authentification et accéder à un compte sans connaître son mot de passe.",
		remediation:
			"Utiliser des requêtes paramétrées, valider les entrées côté serveur et appliquer des tests de sécurité aux chemins d'authentification.",
	},
	{
		title: "XSS réfléchie — exécution dans le navigateur",
		owasp: "A03:2021 · Injection",
		severity: "Moyenne",
		severityClass: "border-yellow-400/30 bg-yellow-400/10 text-yellow-300",
		vector: "Paramètre de recherche · navigateur et Burp Suite",
		payload: "<iframe src=\"javascript:alert('XSS')\">",
		impact:
			"Une valeur de recherche renvoyée sans encodage peut exécuter du JavaScript dans le contexte de l'application pour la personne qui ouvre le lien.",
		remediation:
			"Encoder les sorties selon leur contexte, éviter les sinks DOM dangereux et déployer une Content Security Policy restrictive.",
	},
	{
		title: "XSS persistante — contenu utilisateur non neutralisé",
		owasp: "A03:2021 · Injection",
		severity: "Élevée",
		severityClass: "border-orange-400/30 bg-orange-400/10 text-orange-300",
		vector: "Champ de retour/commentaire · Burp Suite",
		payload: "<iframe src=\"javascript:alert('XSS')\">",
		impact:
			"Un contenu malveillant enregistré puis affiché peut s'exécuter pour chaque utilisateur consultant la page concernée.",
		remediation:
			"Appliquer une validation serveur, encoder les contenus au rendu et utiliser une bibliothèque de sanitation HTML avec une liste d'autorisation.",
	},
	{
		title: "IDOR — accès à un panier par identifiant",
		owasp: "A01:2021 · Contrôle d'accès défaillant",
		severity: "Élevée",
		severityClass: "border-orange-400/30 bg-orange-400/10 text-orange-300",
		vector: "Endpoint de panier · Burp Suite Repeater",
		payload: "GET /rest/basket/1 HTTP/1.1\nHost: 127.0.0.1:3000\nAuthorization: Bearer <jeton_de_session>",
		impact:
			"Modifier un identifiant séquentiel peut exposer les données du panier d'un autre compte si le serveur ne vérifie pas sa propriété.",
		remediation:
			"Vérifier côté serveur l'appartenance de chaque ressource à l'utilisateur authentifié et ne pas considérer un identifiant difficile à deviner comme une autorisation.",
	},
	{
		title: "Fichier sensible accessible depuis le répertoire FTP",
		owasp: "A01:2021 · Contrôle d'accès défaillant",
		severity: "Moyenne",
		severityClass: "border-yellow-400/30 bg-yellow-400/10 text-yellow-300",
		vector: "Répertoire de fichiers publié · navigateur / curl",
		payload: "curl -i http://127.0.0.1:3000/ftp/acquisitions.md",
		impact:
			"Un document interne placé dans un répertoire publiquement servi peut révéler des informations confidentielles sans authentification.",
		remediation:
			"Retirer les documents sensibles des répertoires publics, appliquer des contrôles d'accès et vérifier les fichiers embarqués lors du déploiement.",
	},
	{
		title: "Accès non autorisé à la section d'administration",
		owasp: "A01:2021 · Contrôle d'accès défaillant",
		severity: "Élevée",
		severityClass: "border-orange-400/30 bg-orange-400/10 text-orange-300",
		vector: "Route d'administration · navigateur",
		payload: "http://127.0.0.1:3000/#/administration",
		impact:
			"Si l'accès est contrôlé uniquement par l'interface, une personne peut atteindre une route privilégiée et consulter des fonctions d'administration.",
		remediation:
			"Appliquer une autorisation vérifiée côté serveur sur chaque route et opération privilégiée ; masquer un lien dans l'interface ne constitue pas un contrôle d'accès.",
	},
	{
		title: "Réinitialisation de mot de passe fondée sur une réponse devinable",
		owasp: "A07:2021 · Identification et authentification",
		severity: "Élevée",
		severityClass: "border-orange-400/30 bg-orange-400/10 text-orange-300",
		vector: "Formulaire de mot de passe oublié · proxy Burp Suite",
		payload:
			"1. Ouvrir « Mot de passe oublié » dans l'instance locale.\n2. Intercepter la requête avec Burp Suite.\n3. Vérifier si la réponse secrète est publique, triviale ou devinable.",
		impact:
			"Une réponse de sécurité issue d'informations publiques ou faciles à deviner peut permettre la prise de contrôle du compte.",
		remediation:
			"Remplacer les questions secrètes par des jetons aléatoires à usage unique, expirables et transmis par un canal vérifié ; limiter les tentatives.",
	},
	{
		title: "En-têtes de sécurité HTTP à renforcer",
		owasp: "A05:2021 · Mauvaise configuration de sécurité",
		severity: "Moyenne",
		severityClass: "border-yellow-400/30 bg-yellow-400/10 text-yellow-300",
		vector: "Réponse HTTP · curl et inspection Burp Suite",
		payload: "curl -sSI http://127.0.0.1:3000/",
		impact:
			"L'absence ou la faiblesse de certains en-têtes réduit les protections du navigateur contre les contenus injectés, le framing abusif et les interprétations MIME inattendues.",
		remediation:
			"Configurer et vérifier une CSP adaptée, X-Content-Type-Options: nosniff, une politique de framing restrictive et Strict-Transport-Security en HTTPS.",
	},
];

const methodology = [
	{
		title: "1. Définir le périmètre",
		description:
			"Déployer OWASP Juice Shop en local et limiter les tests à cette application volontairement vulnérable.",
	},
	{
		title: "2. Cartographier l'application",
		description:
			"Parcourir les fonctions, relever les routes et paramètres, puis observer les requêtes avec le proxy Burp Suite.",
	},
	{
		title: "3. Vérifier les hypothèses",
		description:
			"Reproduire manuellement les scénarios dans le laboratoire Kali Linux et conserver les requêtes/réponses utiles comme preuves.",
	},
	{
		title: "4. Évaluer et corriger",
		description:
			"Qualifier l'impact, associer les constats aux catégories OWASP Top 10 et proposer des mesures vérifiables.",
	},
];

const summary = [
	{ title: "Injection SQL — authentification", owasp: "A03", severity: "Élevée" },
	{ title: "XSS réfléchie", owasp: "A03", severity: "Moyenne" },
	{ title: "XSS persistante", owasp: "A03", severity: "Élevée" },
	{ title: "IDOR — panier", owasp: "A01", severity: "Élevée" },
	{ title: "Exposition d'un document", owasp: "A01", severity: "Moyenne" },
	{ title: "Section d'administration", owasp: "A01", severity: "Élevée" },
	{ title: "Réinitialisation de mot de passe", owasp: "A07", severity: "Élevée" },
	{ title: "En-têtes HTTP", owasp: "A05", severity: "Moyenne" },
];

const severityClass = (severity: string) =>
	severity === "Élevée"
		? "text-orange-300"
		: severity === "Critique"
			? "text-red-300"
			: "text-yellow-300";
---

<Layout
	title="Write-up : OWASP Juice Shop — Marc Sylvinho"
	description="Audit de sécurité web complet sur OWASP Juice Shop — 8 vulnérabilités OWASP Top 10 exploitées sous Kali Linux"
>
	<main class="min-h-screen bg-gray-950 px-5 pb-20 pt-24 text-gray-200 sm:px-8">
		<article class="mx-auto max-w-4xl">
			<nav aria-label="Fil d'Ariane" class="mb-7 text-sm text-gray-500">
				<a class="transition-colors hover:text-green-400" href="/">Portfolio</a>
				<span aria-hidden="true" class="px-2">→</span>
				<a class="transition-colors hover:text-green-400" href="/#projets">Write-ups</a>
				<span aria-hidden="true" class="px-2">→</span>
				<span aria-current="page" class="text-gray-300">OWASP Juice Shop</span>
			</nav>

			<a
				href="/#projets"
				class="inline-flex items-center rounded-lg border border-gray-700 px-4 py-2 text-sm text-gray-300 transition-colors hover:border-green-400/50 hover:text-green-300"
			>
				← Retour au portfolio
			</a>

			<header class="mt-10 border-b border-gray-800 pb-8">
				<p class="text-sm font-semibold uppercase tracking-[0.2em] text-green-400">
					Write-up · Sécurité applicative
				</p>
				<h1 class="mt-3 text-3xl font-bold leading-tight text-white sm:text-5xl">
					OWASP Juice Shop — Audit de sécurité web
				</h1>
				<div class="mt-5 flex flex-wrap gap-2">
					{
						["OWASP Top 10", "Kali Linux", "Burp Suite", "8 vulnérabilités"].map((badge) => (
							<span class="rounded-full border border-green-400/20 bg-green-400/5 px-3 py-1 text-xs font-medium text-green-300">
								{badge}
							</span>
						))
					}
				</div>
				<p class="mt-5 text-sm leading-6 text-gray-400">
					Contexte : TP Bachelor Cybersécurité ESAIP · Stage Mongazon · Pratique personnelle
				</p>
				<p class="mt-1 text-sm text-gray-500">
					Date : <time datetime="2026-10">Octobre 2026</time>
				</p>
			</header>

			<section aria-labelledby="executive-summary" class="mt-10">
				<h2 id="executive-summary" class="text-2xl font-bold text-white">
					Résumé exécutif
				</h2>
				<p class="mt-4 leading-7 text-gray-300">
					Ce write-up présente huit scénarios représentatifs de faiblesses web étudiés sur
					OWASP Juice Shop, application volontairement vulnérable. Les tests couvrent
					l'injection, les failles XSS, les contrôles d'accès, l'authentification et la
					configuration HTTP. Ils sont destinés exclusivement à une instance locale ou à un
					environnement explicitement autorisé ; les constats et payloads peuvent varier selon
					la version de l'application.
				</p>
			</section>

			<section aria-labelledby="environment" class="mt-10">
				<h2 id="environment" class="text-2xl font-bold text-white">Environnement technique</h2>
				<div class="mt-4 overflow-x-auto rounded-xl border border-gray-800">
					<table class="w-full min-w-[32rem] text-left text-sm">
						<tbody class="divide-y divide-gray-800">
							<tr>
								<th scope="row" class="w-1/3 bg-gray-900 px-4 py-3 font-medium text-gray-300">Cible</th>
								<td class="px-4 py-3 text-gray-400">OWASP Juice Shop — instance locale de laboratoire</td>
							</tr>
							<tr>
								<th scope="row" class="bg-gray-900 px-4 py-3 font-medium text-gray-300">Système</th>
								<td class="px-4 py-3 text-gray-400">Kali Linux</td>
							</tr>
							<tr>
								<th scope="row" class="bg-gray-900 px-4 py-3 font-medium text-gray-300">Proxy d'interception</th>
								<td class="px-4 py-3 text-gray-400">Burp Suite Community Edition</td>
							</tr>
							<tr>
								<th scope="row" class="bg-gray-900 px-4 py-3 font-medium text-gray-300">Outils complémentaires</th>
								<td class="px-4 py-3 text-gray-400">Navigateur web, curl, DevTools</td>
							</tr>
							<tr>
								<th scope="row" class="bg-gray-900 px-4 py-3 font-medium text-gray-300">Périmètre</th>
								<td class="px-4 py-3 text-gray-400">Application web et endpoints exposés par l'instance locale</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section aria-labelledby="methodology" class="mt-10">
				<h2 id="methodology" class="text-2xl font-bold text-white">Méthodologie</h2>
				<ol class="mt-5 grid gap-4 sm:grid-cols-2">
					{
						methodology.map((step) => (
							<li class="rounded-xl border border-gray-800 bg-gray-900 p-5">
								<h3 class="font-semibold text-green-300">{step.title}</h3>
								<p class="mt-2 text-sm leading-6 text-gray-400">{step.description}</p>
							</li>
						))
					}
				</ol>
			</section>

			<section aria-labelledby="findings" class="mt-12">
				<h2 id="findings" class="text-2xl font-bold text-white">Vulnérabilités observées</h2>
				<div class="mt-5 space-y-5">
					{
						findings.map((finding, index) => (
							<section
								id={`finding-${index + 1}`}
								class="rounded-xl border border-gray-800 bg-gray-900 p-5 sm:p-6"
								aria-labelledby={`finding-title-${index + 1}`}
							>
								<div class="flex flex-wrap items-start justify-between gap-3">
									<h3 id={`finding-title-${index + 1}`} class="text-lg font-bold text-white">
										{index + 1}. {finding.title}
									</h3>
									<span
										class={`rounded-full border px-3 py-1 text-xs font-medium ${finding.severityClass}`}
									>
										{finding.severity}
									</span>
								</div>
								<p class="mt-2 text-xs font-medium text-green-300">{finding.owasp}</p>
								<p class="mt-4 text-sm leading-6 text-gray-400">
									<strong class="text-gray-200">Vecteur et outil :</strong> {finding.vector}
								</p>
								<pre class="mt-4 overflow-x-auto rounded-lg border border-gray-800 bg-[#0d1117] p-4 text-sm leading-6 text-green-200"><code>{finding.payload}</code></pre>
								<p class="mt-4 text-sm leading-6 text-gray-300">
									<strong class="text-white">Impact :</strong> {finding.impact}
								</p>
								<p class="mt-3 text-sm leading-6 text-gray-300">
									<strong class="text-white">Remédiation :</strong> {finding.remediation}
								</p>
							</section>
						))
					}
				</div>
			</section>

			<section aria-labelledby="summary-table" class="mt-12">
				<h2 id="summary-table" class="text-2xl font-bold text-white">Tableau de synthèse</h2>
				<div class="mt-4 overflow-x-auto rounded-xl border border-gray-800">
					<table class="w-full min-w-[36rem] text-left text-sm">
						<thead class="bg-gray-900 text-xs uppercase tracking-wide text-gray-400">
							<tr>
								<th scope="col" class="px-4 py-3">#</th>
								<th scope="col" class="px-4 py-3">Constat</th>
								<th scope="col" class="px-4 py-3">OWASP</th>
								<th scope="col" class="px-4 py-3">Sévérité</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							{
								summary.map((item, index) => (
									<tr>
										<td class="px-4 py-3 text-gray-500">{index + 1}</td>
										<td class="px-4 py-3 text-gray-200">{item.title}</td>
										<td class="px-4 py-3 text-gray-400">{item.owasp}</td>
										<td class={`px-4 py-3 font-medium ${severityClass(item.severity)}`}>
											{item.severity}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</section>

			<section aria-labelledby="recommendations" class="mt-12">
				<h2 id="recommendations" class="text-2xl font-bold text-white">
					Recommandations générales
				</h2>
				<ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-gray-300 marker:text-green-400">
					<li>Utiliser des requêtes paramétrées et une validation des données côté serveur.</li>
					<li>Encoder les sorties, assainir les contenus HTML et adopter une CSP restrictive.</li>
					<li>Appliquer le contrôle d'accès à chaque requête et vérifier la propriété des objets.</li>
					<li>Protéger le parcours de récupération de compte avec des jetons aléatoires, expirables et à usage unique.</li>
					<li>Sortir les fichiers sensibles du répertoire public et limiter les informations renvoyées par les endpoints.</li>
					<li>Configurer les en-têtes de sécurité, journaliser les événements utiles et retester les corrections.</li>
				</ul>
				<p class="mt-5 rounded-lg border border-yellow-400/20 bg-yellow-400/5 p-4 text-sm leading-6 text-yellow-200/80">
					Note : OWASP Juice Shop est une cible d'entraînement. Ne reproduisez ces tests que sur
					votre instance de laboratoire ou avec une autorisation explicite.
				</p>
			</section>

			<footer class="mt-12 border-t border-gray-800 pt-8">
				<div class="flex flex-wrap gap-3">
					<a
						href="https://github.com/zeus02376"
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-lg border border-gray-700 px-4 py-2 text-sm text-gray-300 transition-colors hover:border-green-400/50 hover:text-green-300"
					>
						GitHub ↗
					</a>
					<a
						href="https://tryhackme.com/p/zeusmarc54"
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-lg border border-gray-700 px-4 py-2 text-sm text-gray-300 transition-colors hover:border-green-400/50 hover:text-green-300"
					>
						TryHackMe ↗
					</a>
				</div>
				<a
					href="/#projets"
					class="mt-7 inline-flex items-center rounded-lg bg-green-500 px-5 py-3 text-sm font-semibold text-gray-950 transition-colors hover:bg-green-400"
				>
					← Retour au portfolio
				</a>
			</footer>
		</article>
	</main>
</Layout>

<style>
	pre {
		color: #d1fae5;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
