	function applyLang(lang: "fr" | "en") {
		document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
			const key = element.getAttribute("data-i18n");
			if (key && translations[lang][key]) {
				element.textContent = translations[lang][key];
			}
		});
		localStorage.setItem("lang", lang);
		document.documentElement.lang = lang;

		const toggle = document.getElementById("lang-toggle");
		const targetLang = lang === "fr" ? "EN" : "FR";
		if (toggle) toggle.textContent = targetLang;
	}

	const savedLang = localStorage.getItem("lang") === "en" ? "en" : "fr";
	applyLang(savedLang);

	const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");
	const languageToggle = document.getElementById("lang-toggle");
	const navbar = document.querySelector<HTMLElement>("[data-navbar]");

	window.addEventListener("scroll", () => {
		if (!navbar) return;

		navbar.classList.toggle("bg-gray-900/95", window.scrollY > 0);
		navbar.classList.toggle("backdrop-blur-md", window.scrollY > 0);
	});

	menuToggle?.addEventListener("click", () => {
		if (!mobileMenu) return;

		const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
		mobileMenu.classList.toggle("hidden", isExpanded);
		menuToggle.setAttribute("aria-expanded", String(!isExpanded));
		menuToggle.setAttribute("aria-label", isExpanded ? "Ouvrir le menu" : "Fermer le menu");
	});

	mobileMenu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			mobileMenu.classList.add("hidden");
			menuToggle?.setAttribute("aria-expanded", "false");
			menuToggle?.setAttribute("aria-label", "Ouvrir le menu");
		});
	});

	languageToggle?.addEventListener("click", () => {
		const current = localStorage.getItem("lang") === "en" ? "en" : "fr";
		applyLang(current === "fr" ? "en" : "fr");
		window.location.reload();
	});
</script>
