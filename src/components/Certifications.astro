---
const certifications = [
	{
		title: "SOC Analyst",
		issuer: "TryHackMe",
		description:
			"Détection d'intrusion, analyse de logs, SIEM, investigation d'incidents, blue team",
		badge: "Certifié",
		accent: "bg-green-400",
		badgeClass: "bg-green-400/10 text-green-300",
		icon: "shield",
		href: "https://tryhackme.com/p/zeusmarc54",
	},
	{
		title: "Jr Penetration Tester",
		issuer: "TryHackMe",
		description:
			"Méthodologie pentest, exploitation web, post-exploitation, reporting, OWASP Top 10",
		badge: "Certifié",
		accent: "bg-red-400",
		badgeClass: "bg-green-400/10 text-green-300",
		icon: "target",
		href: "https://tryhackme.com/p/zeusmarc54",
	},
	{
		title: "TOEIC 735 — Niveau B2",
		issuer: "ETS Global",
		description:
			"Anglais professionnel — Communication écrite et orale en milieu professionnel",
		badge: "B2",
		accent: "bg-blue-400",
		badgeClass: "bg-blue-400/10 text-blue-300",
		icon: "toeic",
		href: "",
	},
	{
		title: "DELF B2 — Français",
		issuer: "Alliance Française / CIEP",
		description: "Diplôme d'études en langue française — Niveau avancé",
		badge: "B2",
		accent: "bg-sky-300",
		badgeClass: "bg-blue-400/10 text-blue-300",
		icon: "delf",
		href: "",
	},
];

const education = [
	{
		year: "2025 — 2027",
		title: "Cycle Ingénieur IRA — Bac+5",
		school: "ESAIP École d'Ingénieurs (réseau La Salle)",
		location: "Angers, France",
		detail: "Informatique, Réseaux & Applications — Alternance",
		erasmus: "Erasmus 🌍 Gebze Technical University — Turquie (2025/2026)",
	},
	{
		year: "2023 — 2025",
		title: "Bachelor of Engineering — Computer Science",
		school: "Institut Universitaire de la Côte (IUC)",
		location: "Douala, Cameroun",
		detail: "GPA 2,79/4",
	},
	{
		year: "2023",
		title: "GCE A-Levels",
		school: "Cameroun",
		location: "",
		detail: "",
	},
];
---

<section
	id="certifications"
	data-credentials-section
	aria-labelledby="credentials-title"
	class="scroll-mt-16 bg-gray-950 px-6 py-24"
>
	<div class="mx-auto max-w-6xl">
		<header class="mb-12 text-center">
			<p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-green-400">
				Certifications &amp; Formation
			</p>
			<h2 id="credentials-title" class="text-3xl font-bold text-white sm:text-4xl">
				Mes credentials
			</h2>
			<p class="mt-4 text-gray-400">
				Certifications, diplômes et parcours académique
			</p>
		</header>

		<div>
			<h3 class="mb-5 text-xl font-semibold text-white">Certifications</h3>
			<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
				{
					certifications.map((certification, index) => (
						<article
							data-credential-card
							style={`--reveal-delay: ${index * 100}ms`}
							class="overflow-hidden rounded-xl border border-gray-800 bg-gray-900 transition-colors duration-300 hover:border-green-400/40"
						>
							<div class:list={["h-1 w-full", certification.accent]} aria-hidden="true" />
							<div class="flex h-full flex-col p-5 sm:p-6">
								<div class="flex items-start justify-between gap-4">
									<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gray-800">
										{certification.icon === "shield" && (
											<svg
												aria-hidden="true"
												viewBox="0 0 24 24"
												fill="none"
												class="h-7 w-7 text-red-400"
											>
												<path
													d="M12 2.5 20 5v6.2c0 5.1-3.4 8.5-8 10.3-4.6-1.8-8-5.2-8-10.3V5l8-2.5Z"
													fill="currentColor"
													fill-opacity=".18"
													stroke="currentColor"
													stroke-width="1.7"
													stroke-linejoin="round"></path>
												<path
													d="m8.7 12 2.1 2.1 4.6-4.7"
													stroke="currentColor"
													stroke-width="1.7"
													stroke-linecap="round"
													stroke-linejoin="round"></path>
											</svg>
										)}
										{certification.icon === "target" && (
											<svg
												aria-hidden="true"
												viewBox="0 0 24 24"
												fill="none"
												class="h-7 w-7 text-red-400"
											>
												<circle
													cx="12"
													cy="12"
													r="9"
													stroke="currentColor"
													stroke-width="1.7"></circle>
												<circle
													cx="12"
													cy="12"
													r="5.5"
													stroke="currentColor"
													stroke-width="1.7"></circle>
												<circle cx="12" cy="12" r="2" fill="currentColor"></circle>
												<path
													d="m13.5 10.5 6-6m-3.7 0h3.7v3.7"
													stroke="currentColor"
													stroke-width="1.7"
													stroke-linecap="round"
													stroke-linejoin="round"></path>
											</svg>
										)}
										{certification.icon === "toeic" && (
											<span class="text-2xl font-black text-blue-400" aria-hidden="true">T</span>
										)}
										{certification.icon === "delf" && (
											<span class="text-2xl font-black text-sky-300" aria-hidden="true">D</span>
										)}
									</div>
									<span
										class:list={[
											"rounded-full px-3 py-1 text-xs font-semibold",
											certification.badgeClass,
										]}
									>
										{certification.badge}
									</span>
								</div>

								<div class="mt-5 flex flex-1 flex-col">
									<h4 class="text-lg font-bold text-white">{certification.title}</h4>
									<p class="mt-1 text-sm font-medium text-gray-300">{certification.issuer}</p>
									<p class="mt-3 flex-1 text-sm leading-6 text-gray-400">
										{certification.description}
									</p>
									{certification.href && (
										<a
											href={certification.href}
											target="_blank"
											rel="noopener noreferrer"
											class="mt-5 inline-flex w-fit items-center gap-2 text-sm font-medium text-green-400 transition-colors hover:text-green-300"
										>
											Voir le profil TryHackMe <span aria-hidden="true">↗</span>
										</a>
									)}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>

		<div class="mt-16">
			<h3 class="mb-7 text-xl font-semibold text-white">Parcours académique</h3>
			<ol class="ml-2 border-l-2 border-green-500/30">
				{
					education.map((step, index) => (
						<li
							data-education-step
							style={`--reveal-delay: ${index * 180}ms`}
							class="relative pb-7 pl-7 last:pb-0 sm:pl-9"
						>
							<span
								class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full border-2 border-green-300 bg-green-500 shadow-[0_0_12px_rgb(34_197_94_/_0.35)]"
								aria-hidden="true"
							/>
							<div class="rounded-lg border border-gray-800 bg-gray-900 p-4 sm:p-5">
								<p class="text-sm font-semibold text-green-400">{step.year}</p>
								<h4 class="mt-1 text-lg font-bold text-white">{step.title}</h4>
								<p class="mt-2 text-sm text-gray-300">{step.school}</p>
								{step.location && <p class="mt-1 text-sm text-gray-400">{step.location}</p>}
								{step.detail && <p class="mt-2 text-sm text-gray-400">{step.detail}</p>}
								{step.erasmus && (
									<p class="mt-4 inline-flex rounded-lg border border-green-400/20 bg-green-400/5 px-3 py-2 text-sm text-green-300">
										{step.erasmus}
									</p>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<script>
	const credentialsSection = document.querySelector<HTMLElement>("[data-credentials-section]");
	const revealItems = credentialsSection?.querySelectorAll<HTMLElement>(
		"[data-credential-card], [data-education-step]",
	);

	if (credentialsSection && revealItems?.length && "IntersectionObserver" in window) {
		credentialsSection.dataset.credentialsAnimate = "true";

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);

		revealItems.forEach((item) => observer.observe(item));
	}
</script>

<style>
	[data-credentials-section][data-credentials-animate] [data-credential-card],
	[data-credentials-section][data-credentials-animate] [data-education-step] {
		opacity: 0;
		transform: translateY(1rem);
		transition:
			opacity 600ms ease-out,
			transform 600ms ease-out;
		transition-delay: var(--reveal-delay);
	}

	[data-credentials-section][data-credentials-animate] [data-credential-card].is-visible,
	[data-credentials-section][data-credentials-animate] [data-education-step].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-credentials-section][data-credentials-animate] [data-credential-card],
		[data-credentials-section][data-credentials-animate] [data-education-step] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
