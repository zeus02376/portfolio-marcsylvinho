---
const categories = [
	{
		title: "Cybersécurité",
		icon: "🔐",
		accent: true,
		skills: [
			{ name: "Pentest Web (OWASP Top 10)", level: 80 },
			{ name: "SOC & Blue Team", level: 75 },
			{ name: "Analyse réseau (Wireshark/Nmap)", level: 75 },
			{ name: "Active Directory", level: 60 },
			{ name: "Kali Linux / Burp Suite", level: 80 },
			{ name: "OSINT", level: 70 },
		],
	},
	{
		title: "Développement",
		icon: "💻",
		accent: false,
		skills: [
			{ name: "Python", level: 80 },
			{ name: "React / TypeScript", level: 75 },
			{ name: "Express.js / Node.js", level: 70 },
			{ name: "PostgreSQL / Prisma", level: 65 },
			{ name: "Docker", level: 70 },
			{ name: "API REST", level: 75 },
		],
	},
	{
		title: "Réseaux & Systèmes",
		icon: "🌐",
		accent: false,
		skills: [
			{ name: "TCP/IP, VLAN, VPN", level: 75 },
			{ name: "Linux (Admin + Bash)", level: 80 },
			{ name: "pfSense / pare-feu", level: 65 },
			{ name: "GitLab CI/CD", level: 65 },
			{ name: "Active Directory", level: 60 },
			{ name: "pm2 / VPS deployment", level: 70 },
		],
	},
	{
		title: "IA & Outils",
		icon: "🤖",
		accent: false,
		skills: [
			{ name: "Claude Code (usage quotidien)", level: 90 },
			{ name: "Ollama / LLM local (ZEUS-AI)", level: 75 },
			{ name: "NLP (SmishGuard)", level: 65 },
			{ name: "GitHub Actions", level: 65 },
			{ name: "Ansible", level: 55 },
			{ name: "Splunk (SOC)", level: 60 },
		],
	},
];

const tools = [
	"Burp Suite",
	"Nmap",
	"Wireshark",
	"Metasploit",
	"Nessus",
	"Splunk",
	"Ghidra",
	"Docker",
	"Git",
	"VS Code",
	"Kali Linux",
	"pfSense",
];
---

<section
	id="competences"
	data-skills-section
	aria-labelledby="skills-title"
	class="scroll-mt-16 bg-gray-950 px-6 py-24"
>
	<div class="mx-auto max-w-6xl">
		<header class="mb-12 text-center">
			<p data-i18n="skills_label" class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-green-400">
				Mes compétences
			</p>
			<h2 data-i18n="skills_title" id="skills-title" class="text-3xl font-bold text-white sm:text-4xl">
				Ce que je sais faire
			</h2>
			<p data-i18n="skills_subtitle" class="mt-4 text-gray-400">
				Cybersécurité en priorité, développement en support
			</p>
		</header>

		<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
			{
				categories.map(({ title, icon, accent, skills: categorySkills }) => (
					<article
						data-skill-card
						class:list={[
							"rounded-xl border bg-gray-900 p-5 transition-colors duration-300 hover:border-green-400/40 sm:p-6",
							accent ? "border-green-400/30" : "border-gray-800",
						]}
					>
						<h3 class="mb-6 flex items-center gap-3 text-lg font-semibold text-white">
							<span aria-hidden="true" class="text-xl">
								{icon}
							</span>
							{title}
						</h3>

						<ul class="space-y-4">
							{
								categorySkills.map(({ name, level }) => (
									<li>
										<div class="mb-2 flex items-center justify-between gap-3 text-sm">
											<span class="text-gray-300">{name}</span>
											<span class="shrink-0 text-xs text-gray-500">{level}%</span>
										</div>
										<div
											role="progressbar"
											aria-label={name}
											aria-valuemin="0"
											aria-valuemax="100"
											aria-valuenow={level}
											class="h-2 overflow-hidden rounded-full bg-gray-800"
										>
											<span
												data-skill-fill
												style={`--skill-level: ${level}%`}
												class="skill-fill block h-full rounded-full bg-gradient-to-r from-green-500 to-emerald-400"
											/>
										</div>
									</li>
								))
							}
						</ul>
					</article>
				))
			}
		</div>

		<div class="mt-12">
			<h3 data-i18n="skills_tools" class="mb-4 text-center text-sm font-semibold uppercase tracking-wider text-gray-400">
				Outils maîtrisés
			</h3>
			<ul class="flex flex-wrap justify-center gap-2" aria-label="Outils maîtrisés">
				{
					tools.map((tool) => (
						<li class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-1 text-sm text-gray-300">
							{tool}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	const skillsSection = document.querySelector<HTMLElement>("[data-skills-section]");
	const skillCards = skillsSection?.querySelectorAll<HTMLElement>("[data-skill-card]");

	if (skillsSection && skillCards?.length && "IntersectionObserver" in window) {
		skillsSection.dataset.skillsAnimate = "true";

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);

		skillCards.forEach((card) => observer.observe(card));
	}
</script>

<style>
	.skill-fill {
		width: var(--skill-level);
	}

	[data-skills-section][data-skills-animate] [data-skill-card] {
		opacity: 0;
		transform: translateY(1rem);
		transition:
			opacity 600ms ease-out,
			transform 600ms ease-out,
			border-color 300ms ease-out;
	}

	[data-skills-section][data-skills-animate] [data-skill-card] .skill-fill {
		width: 0;
		transition: width 900ms ease-out;
	}

	[data-skills-section][data-skills-animate] [data-skill-card].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	[data-skills-section][data-skills-animate] [data-skill-card].is-visible .skill-fill {
		width: var(--skill-level);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-skills-section][data-skills-animate] [data-skill-card],
		[data-skills-section][data-skills-animate] [data-skill-card] .skill-fill {
			opacity: 1;
			transform: none;
			transition: none;
		}

		[data-skills-section][data-skills-animate] [data-skill-card] .skill-fill {
			width: var(--skill-level);
		}
	}
</style>
