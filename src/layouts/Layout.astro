---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { type Lang } from "../i18n/translations";

interface Props {
	title: string;
	description?: string;
	lang?: Lang;
}

const {
	title,
	description = "Étudiant Ingénieur IR3 — Cybersécurité & Réseaux — ESAIP Angers",
	lang = "fr",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://portfolio-marcsylvinho.pages.dev/" />
		<meta
			property="og:title"
			content="Marc Sylvinho Tsafack — Étudiant Ingénieur IR3 — Cybersécurité & Réseaux"
		/>
		<meta
			property="og:description"
			content="Étudiant Ingénieur IR3 — Cybersécurité & Réseaux — ESAIP Angers"
		/>
		<meta
			property="og:image"
			content="https://portfolio-marcsylvinho.pages.dev/photo-marc.png"
		/>
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:locale:alternate" content="en_US" />
		<meta property="og:site_name" content="Portfolio — Marc Sylvinho Tsafack" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Marc Sylvinho Tsafack — Cybersécurité &amp; Dev" />
		<meta
			name="twitter:description"
			content="Étudiant Ingénieur IR3 — Cybersécurité & Réseaux — ESAIP Angers"
		/>
		<meta
			name="twitter:image"
			content="https://portfolio-marcsylvinho.pages.dev/photo-marc.png"
		/>

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "ProfilePage",
				"mainEntity": {
					"@type": "Person",
					"@id": "https://portfolio-marcsylvinho.pages.dev/#marc",
					"name": "Marc Sylvinho Tsafack Lekeudjio",
					"alternateName": "zeus02376",
					"jobTitle": "Étudiant Ingénieur IR3 — Cybersécurité & Réseaux — ESAIP Angers",
					"description": "Étudiant Ingénieur IR3 Cybersécurité & Réseaux — ESAIP Angers",
					"url": "https://portfolio-marcsylvinho.pages.dev",
					"image": "https://portfolio-marcsylvinho.pages.dev/photo-marc.png",
					"email": "zeusmarc54@gmail.com",
					"nationality": "Camerounaise",
					"alumniOf": [
						{
							"@type": "CollegeOrUniversity",
							"name": "Institut Universitaire de la Côte (IUC)",
							"address": "Douala, Cameroun"
						},
						{
							"@type": "CollegeOrUniversity",
							"name": "ESAIP École d'Ingénieurs",
							"address": "Angers, France",
							"description": "Bachelor Cybersécurité & Réseaux"
						}
					],
					"worksFor": {
						"@type": "Organization",
						"@id": "https://portfolio-marcsylvinho.pages.dev/#anansi",
						"name": "ANANSI",
						"description": "Projet entrepreneurial en cybersécurité"
					},
					"knowsAbout": [
						"Cybersécurité",
						"Pentest",
						"SOC",
						"OWASP",
						"Python",
						"React",
						"TypeScript",
						"Docker",
						"Active Directory",
						"Kali Linux",
						"Burp Suite"
					],
					"sameAs": [
						"https://github.com/zeus02376",
						"https://www.linkedin.com/in/marc-sylvinho-tsafack-lekeudjio-87183a3a8/",
						"https://tryhackme.com/p/zeusmarc54"
					]
				}
			}
		</script>
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-gray-950 text-white">
		<Navbar />
		<slot />
	</body>
</html>
