---
const categories = [
	{
		title: "Cybersécurité Défensive / SOC",
		titleKey: "skills_domain_defensive",
		icon: "🔐",
		skills: [
			{ name: "Analyse de logs & SIEM (Wazuh, Splunk)", level: "project" },
			{ name: "Réponse à incident (NIST SP 800-61)", level: "learning" },
			{ name: "Threat Intelligence", level: "learning" },
			{ name: "Détection d'intrusion (IDS/IPS)", level: "project" },
		],
	},
	{
		title: "Cybersécurité Offensive / Pentest",
		titleKey: "skills_domain_offensive",
		icon: "🎯",
		skills: [
			{ name: "Tests d'intrusion web (OWASP Top 10)", level: "client" },
			{ name: "Reconnaissance & énumération", level: "project" },
			{ name: "Exploitation (Metasploit, Burp Suite)", level: "learning" },
			{ name: "CTF (TryHackMe, Root-Me)", level: "practice" },
		],
	},
	{
		title: "Réseaux & Infrastructure",
		titleKey: "skills_domain_networks",
		icon: "🌐",
		skills: [
			{ name: "TCP/IP, routage, switching", level: "mastered" },
			{ name: "Firewall & segmentation VLAN", level: "project" },
			{ name: "VPN, PKI", level: "learning" },
			{ name: "Linux / Windows Server", level: "mastered" },
		],
	},
	{
		title: "Développement",
		titleKey: "skills_domain_development",
		icon: "💻",
		skills: [
			{ name: "Python (scripts sécurité, NLP)", level: "project" },
			{ name: "JavaScript / TypeScript", level: "production" },
			{ name: "React + Express + PostgreSQL", level: "production" },
			{ name: "Astro + Tailwind CSS", level: "production" },
		],
	},
	{
		title: "Cloud & IA",
		titleKey: "skills_domain_cloud_ai",
		icon: "☁️",
		skills: [
			{ name: "Cloudflare (CDN, Pages, Headers)", level: "production" },
			{ name: "Docker", level: "learning" },
			{ name: "LLM local (Ollama, LangChain)", level: "project" },
			{ name: "Git / CI-CD", level: "mastered" },
		],
	},
];

const levels = {
	production: {
		key: "skills_level_production",
		label: "Utilisé en production",
		classes: "border-green-400/20 bg-green-400/10 text-green-300",
	},
	client: {
		key: "skills_level_client",
		label: "Utilisé en mission client",
		classes: "border-green-400/20 bg-green-400/10 text-green-300",
	},
	project: {
		key: "skills_level_project",
		label: "Utilisé en projet",
		classes: "border-blue-400/20 bg-blue-400/10 text-blue-300",
	},
	practice: {
		key: "skills_level_practice",
		label: "Pratique régulière",
		classes: "border-blue-400/20 bg-blue-400/10 text-blue-300",
	},
	learning: {
		key: "skills_level_learning",
		label: "En apprentissage",
		classes: "border-gray-600 bg-gray-800 text-gray-300",
	},
	mastered: {
		key: "skills_level_mastered",
		label: "Maîtrisé",
		classes: "border-green-400/20 bg-green-400/10 text-green-300",
	},
};
---

<section
	id="competences"
	data-skills-section
	aria-labelledby="skills-title"
	class="scroll-mt-16 bg-gray-950 px-6 py-24"
>
	<div class="mx-auto max-w-6xl">
		<header class="mb-12 text-center">
			<p data-i18n="skills_label" class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-green-400">
				Mes compétences
			</p>
			<h2 data-i18n="skills_title" id="skills-title" class="text-3xl font-bold text-white sm:text-4xl">
				Ce que je sais faire
			</h2>
			<p data-i18n="skills_subtitle" class="mt-4 text-gray-400">
				Cybersécurité en priorité, développement en support
			</p>
		</header>

		<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
			{
				categories.map(({ title, titleKey, icon, skills: categorySkills }) => (
					<article
						data-skill-card
						class="rounded-xl border border-gray-800 bg-gray-900 p-5 transition-colors duration-300 hover:border-green-400/40 sm:p-6"
					>
						<h3 class="mb-6 flex items-center gap-3 text-lg font-semibold text-white">
							<span aria-hidden="true" class="text-xl">
								{icon}
							</span>
							<span data-i18n={titleKey}>{title}</span>
						</h3>

						<ul class="space-y-3">
							{
								categorySkills.map(({ name, level }) => (
									<li class="flex items-center justify-between gap-3 border-t border-gray-800/80 pt-3 first:border-0 first:pt-0">
										<span class="text-sm text-gray-300">{name}</span>
										<span
											data-i18n={levels[level].key}
											class:list={[
												"shrink-0 rounded-full border px-2.5 py-1 text-right text-xs font-medium",
												levels[level].classes,
											]}
										>
											{levels[level].label}
										</span>
									</li>
								))
							}
						</ul>
					</article>
				))
			}
		</div>

	</div>
</section>

<script>
	const skillsSection = document.querySelector<HTMLElement>("[data-skills-section]");
	const skillCards = skillsSection?.querySelectorAll<HTMLElement>("[data-skill-card]");

	if (skillsSection && skillCards?.length && "IntersectionObserver" in window) {
		skillsSection.dataset.skillsAnimate = "true";

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);

		skillCards.forEach((card) => observer.observe(card));
	}
</script>

<style>
	[data-skills-section][data-skills-animate] [data-skill-card] {
		opacity: 0;
		transform: translateY(1rem);
		transition:
			opacity 600ms ease-out,
			transform 600ms ease-out,
			border-color 300ms ease-out;
	}

	[data-skills-section][data-skills-animate] [data-skill-card].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-skills-section][data-skills-animate] [data-skill-card] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
