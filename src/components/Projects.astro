<script>
	const projectsSection = document.querySelector<HTMLElement>("[data-projects-section]");
	const projectCards = projectsSection?.querySelectorAll<HTMLElement>("[data-project-card]");

	if (projectsSection && projectCards?.length && "IntersectionObserver" in window) {
		projectsSection.dataset.projectsAnimate = "true";

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.12 },
		);

		projectCards.forEach((card) => observer.observe(card));
	}
</script>

<style>
	[data-projects-section][data-projects-animate] [data-project-card] {
		opacity: 0;
		transform: translateY(1rem);
		transition:
			opacity 600ms ease-out,
			transform 600ms ease-out,
			border-color 300ms ease-out;
		transition-delay: var(--stagger-delay);
	}

	[data-projects-section][data-projects-animate] [data-project-card].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-projects-section][data-projects-animate] [data-project-card] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
