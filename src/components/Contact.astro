---
const contactDetails = [
	{
		icon: "✉",
		label: "Email",
		value: "zeusmarc54@gmail.com",
		href: "mailto:zeusmarc54@gmail.com",
	},
	{ icon: "⌖", label: "Localisation", value: "Angers, France", href: "" },
	{
		icon: "in",
		label: "LinkedIn",
		value: "marc-sylvinho-tsafack",
		href: "https://www.linkedin.com/in/marc-sylvinho-tsafack-lekeudjio-87183a3a8/",
	},
	{
		icon: "⌘",
		label: "TryHackMe",
		value: "zeusmarc54",
		href: "https://tryhackme.com/p/zeusmarc54",
	},
];
---

<section
	id="contact"
	aria-labelledby="contact-title"
	class="scroll-mt-16 bg-gray-900 px-6 py-24"
>
	<div class="mx-auto max-w-4xl">
		<header class="mb-12 text-center">
			<p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-green-400">
				Contact
			</p>
			<h2 id="contact-title" class="text-3xl font-bold text-white sm:text-4xl">
				Travaillons ensemble
			</h2>
			<p class="mx-auto mt-4 max-w-2xl text-gray-400">
				Alternance, projet cybersécurité ou simple échange — je réponds sous 24h
			</p>
		</header>

		<div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-10">
			<div>
				<h3 class="mb-6 text-xl font-semibold text-white">Me contacter directement</h3>
				<ul class="space-y-5">
					{
						contactDetails.map(({ icon, label, value, href }) => (
							<li class="flex items-start gap-4">
								<span
									class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-green-400/15 bg-green-400/5 font-semibold text-green-400"
									aria-hidden="true"
								>
									{icon}
								</span>
								<div class="min-w-0 pt-0.5">
									<p class="text-sm text-gray-500">{label}</p>
									{href ? (
										<a
											href={href}
											target={href.startsWith("https://") ? "_blank" : undefined}
											rel={href.startsWith("https://") ? "noopener noreferrer" : undefined}
											class="break-words text-sm text-gray-200 transition-colors hover:text-green-400"
										>
											{value}
										</a>
									) : (
										<p class="text-sm text-gray-200">{value}</p>
									)}
								</div>
							</li>
						))
					}
				</ul>

				<div class="mt-8 rounded-xl border border-green-400/20 bg-green-400/5 p-4">
					<p class="font-semibold text-green-300">
						<span aria-hidden="true">🟢</span> Disponible pour alternance — Septembre 2026
					</p>
					<p class="mt-2 text-sm leading-6 text-gray-400">
						Domaines : Cybersécurité, Réseaux, SecOps
					</p>
				</div>
			</div>

			<form data-contact-form class="rounded-xl border border-gray-700 bg-gray-800 p-6 sm:p-8">
				<div class="space-y-5">
					<div>
						<label for="contact-name" class="mb-2 block text-sm font-medium text-gray-200">
							Nom complet
						</label>
						<input
							id="contact-name"
							name="name"
							type="text"
							autocomplete="name"
							required
							placeholder="Votre nom"
							class="w-full rounded-lg border border-gray-600 bg-gray-700 px-4 py-3 text-white placeholder:text-gray-400 focus:border-green-500 focus:outline-none focus:ring-1 focus:ring-green-500"
						/>
					</div>

					<div>
						<label for="contact-email" class="mb-2 block text-sm font-medium text-gray-200">
							Email
						</label>
						<input
							id="contact-email"
							name="email"
							type="email"
							autocomplete="email"
							required
							placeholder="vous@exemple.com"
							class="w-full rounded-lg border border-gray-600 bg-gray-700 px-4 py-3 text-white placeholder:text-gray-400 focus:border-green-500 focus:outline-none focus:ring-1 focus:ring-green-500"
						/>
					</div>

					<div>
						<label for="contact-subject" class="mb-2 block text-sm font-medium text-gray-200">
							Sujet
						</label>
						<select
							id="contact-subject"
							name="subject"
							required
							class="w-full rounded-lg border border-gray-600 bg-gray-700 px-4 py-3 text-white focus:border-green-500 focus:outline-none focus:ring-1 focus:ring-green-500"
						>
							<option value="" disabled selected>Choisir un sujet</option>
							<option>Proposition d'alternance</option>
							<option>Projet cybersécurité</option>
							<option>Collaboration technique</option>
							<option>Autre</option>
						</select>
					</div>

					<div>
						<label for="contact-message" class="mb-2 block text-sm font-medium text-gray-200">
							Message
						</label>
						<textarea
							id="contact-message"
							name="message"
							rows="5"
							required
							placeholder="Comment puis-je vous aider ?"
							class="w-full resize-y rounded-lg border border-gray-600 bg-gray-700 px-4 py-3 text-white placeholder:text-gray-400 focus:border-green-500 focus:outline-none focus:ring-1 focus:ring-green-500"
						></textarea>
					</div>
				</div>

				<button
					type="submit"
					class="mt-6 w-full rounded-lg bg-green-500 px-5 py-3 font-semibold text-gray-950 transition-colors hover:bg-green-600"
				>
					Envoyer le message <span aria-hidden="true">→</span>
				</button>
				<p class="mt-3 text-center text-xs text-gray-400">
					Je réponds généralement sous 24h
				</p>
				<p
					data-form-success
					role="status"
					aria-live="polite"
					class="mt-4 hidden rounded-lg border border-green-400/20 bg-green-400/10 p-3 text-sm text-green-300"
				>
					Merci ! Le formulaire a été soumis. Cette démo ne transmet pas encore les messages.
				</p>
			</form>
		</div>
	</div>
</section>

<script>
	const contactForm = document.querySelector<HTMLFormElement>("[data-contact-form]");
	const successMessage = document.querySelector<HTMLElement>("[data-form-success]");

	contactForm?.addEventListener("submit", (event) => {
		event.preventDefault();

		if (!contactForm.reportValidity()) return;

		contactForm.reset();
		successMessage?.classList.remove("hidden");
	});
</script>
